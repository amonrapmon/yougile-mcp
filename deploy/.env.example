# Copy to repository root: cp deploy/.env.example .env && chmod 600 .env
# Never commit .env. Generate secrets ON the DE host.
MCP_DOMAIN=mcp.example.com
TRAEFIK_NETWORK=proxy
TRAEFIK_HTTPS_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# openssl rand -hex 24
CLOUD_DB_PASSWORD=REPLACE_WITH_48_HEX_CHARACTERS
# openssl rand -hex 48
CLOUD_JWT_SECRET=REPLACE_WITH_96_HEX_CHARACTERS
# python3 -c 'import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
CLOUD_ENCRYPTION_KEYS=REPLACE_WITH_FERNET_KEY

CLOUD_OAUTH_REDIRECT_ORIGINS=
# Later, after confirming the vendor identity: companyId:yougileUserId
CLOUD_HOST_ADMIN_SUBJECTS=

# Template for process environment. The Python CLI does not auto-load this file.
# Never commit a filled .env or live YouGile credentials.
YOUGILE_BASE_URL=https://ru.yougile.com

# Local authenticated stdio (yougile-mcp serve).
MCP_TRANSPORT=stdio
MCP_AUTH_MODE=required
# YOUGILE_API_KEY=<set privately in the process environment>
# YOUGILE_COMPANY_ID=<company id>
# MCP_STDIO_IDENTITY_FILE=/absolute/private/path/yougile-agent.json

# Private hosted OAuth shell (yougile-mcp cloud-serve).
# Set MCP_TRANSPORT=http and leave global YOUGILE_API_KEY/YOUGILE_COMPANY_ID unset.
# This process MUST stay on loopback, behind a separately reviewed HTTPS proxy.
MCP_HOST=127.0.0.1
MCP_PORT=8000
# MCP_PUBLIC_URL=https://your-host.example
# CLOUD_DATABASE_URL=<private postgres connection string>
# CLOUD_VALKEY_URL=<private valkey connection string>
# CLOUD_JWT_SECRET=<high entropy 32+ character secret>
# CLOUD_ENCRYPTION_KEYS=<comma-separated Fernet encryption keys>
# CLOUD_OAUTH_REDIRECT_ORIGINS=https://trusted-callback-origin.example
# CLOUD_HOST_ADMIN_SUBJECTS=<companyId:yougileUserId>  # optional exact allowlist
MCP_LOG_LEVEL=INFO

# The checked-in Dockerfile and compose.yaml remain doctor-only verification scaffolds.
# There is no approved public HTTPS deployment in the repository yet.
